# FaceSnap Environment Configuration
# Copy to frontend/.env.local and fill in your values

# AI Chatbot (Groq — free, no credit card needed) — SERVER ONLY.
# Get a key at https://console.groq.com and set it as GROQ_API_KEY
# (never NEXT_PUBLIC_*; the frontend calls /api/chat which proxies securely).
GROQ_API_KEY=
AI_MODEL=llama-3.3-70b-versatile

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase Configuration (public client config)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Backend
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Backend database (system of record — server only)
# SQLite for local dev; use a Postgres DSN in production, e.g.
# DATABASE_URL=postgresql+psycopg://facesnap:secret@localhost:5432/facesnap
# DATABASE_URL=sqlite:///./facesnap.db
# Where face images are stored (swap for a mounted volume / object store)
# FACE_IMAGE_DIR=./data/faces
# Qdrant on-disk index (omit or use :memory: for an ephemeral index)
# QDRANT_PATH=./data/qdrant
# Comma-separated emails granted the admin role on first login
# ADMIN_EMAILS=admin@college.edu

# Backend auth (server only)
# Set REQUIRE_AUTH=true in production so FastAPI verifies Firebase ID tokens.
# REQUIRE_AUTH=false
# Firebase Admin SDK credentials path (production backend only)
# FIREBASE_SERVICE_ACCOUNT_JSON=/run/secrets/firebase-service-account.json
# Optional shared key for Pi/service callers hitting camera endpoints
# PI_SERVICE_KEY=
