# Backend (FastAPI) configuration — copy to backend/.env
# Real environment variables take precedence over this file.

# development | production. Production fails fast on unsafe auth/CORS settings.
APP_ENV=development

# Local development only: treat every request as an admin.
# Production MUST be true; the app refuses to boot otherwise.
REQUIRE_AUTH=false

HOST=0.0.0.0
PORT=8000

# Comma-separated allowed browser origins. Required (no wildcard) in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Per-IP limit for face/verification endpoints (0 disables).
RATE_LIMIT_PER_MINUTE=120

# System of record. SQLite for local dev; Postgres in production:
# DATABASE_URL=postgresql+psycopg://facesnap:secret@localhost:5432/facesnap
DATABASE_URL=sqlite:///./facesnap.db

# Enrollment photos and vector index. Use persistent volumes in production.
FACE_IMAGE_DIR=./data/faces
QDRANT_PATH=./data/qdrant

# Comma-separated emails promoted to admin on first login.
ADMIN_EMAILS=

# Firebase Admin credentials (path to the service-account JSON).
# Required in production; omit locally to use REQUIRE_AUTH=false.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Shared key for camera devices/service callers on /api/pi/* (X-Service-Key).
PI_SERVICE_KEY=
PI_CAMERA_ENABLED=false

# Liveness tuning. A strong pulse passes on its own.
LIVENESS_RPPG_PASS=0.6
