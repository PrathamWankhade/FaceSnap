# Docker / compose ignore list.
# Keep images, local caches, secrets and biometric data out of builds/contexts.

# Backend
backend/.venv/
backend/__pycache__/
backend/app/**/__pycache__/
backend/*.pyc
backend/*.db
backend/*.db-journal
backend/*.db-wal
backend/*.db-shm
backend/data/
backend/app/.insightface/
backend/*.onnx
backend/*.pt
backend/.env
backend/secrets/

# Frontend
frontend/node_modules/
frontend/.next/
frontend/.env.local
frontend/*.log
frontend/.turbo

# Repo-wide
*.log
.env
.env.local
*.env.*
!**.env.example
.DS_Store
Thumbs.db
.vscode/
.idea/
secrets/
.backups/
backups/
